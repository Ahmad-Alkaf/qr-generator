# Canonical origin, no trailing slash. Tracked QR codes embed it forever.
# Build-time value (NEXT_PUBLIC_*). In Coolify mark it "Available at build time".
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string (Prisma). Runtime only.
DATABASE_URL=

# Clerk (build-time for NEXT_PUBLIC_*, runtime for the secret)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Clerk webhook (user sync). Endpoint: /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=

# Upstash Redis (optional). Rate limiting is disabled when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Search Console HTML-tag verification (optional, build-time).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
